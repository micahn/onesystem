{
  // Paths below are written `/path/to/...` and you are expected to substitute them.
  //
  // They cannot be `~/...` or `$HOME/...`: nothing in the config reader expands either
  // one, so a tilde would be a value that parses, loads, and then fails to exec with a
  // message about the wrong file. A literal `/path/to/` fails at the same point but says
  // plainly what is wrong, which is the difference between a fixture and a trap.
  //
  // `onesystem install <model>` prints the exact block for your machine, including the
  // interpreter and the weights directory, which is the part that cannot be written down
  // in a repository at all.

  "host": "127.0.0.1",
  "port": 7331,

  // Wind down after this long with no traffic. Long on purpose: a model load costs
  // 20-54s and 3 GB of VRAM, so exiting sooner than this just moves the cost to the
  // next session. The daemon exits once nothing is warm, releasing the port and the GPU.
  "idleShutdownSecs": 600,

  // How often the idle check runs. A timestamp compare, so this can be cheap.
  "idleSweepSecs": 5,

  // Ceiling on one forwarded MCP call, enforced by the daemon.
  //
  // This line used to claim it matched the laya shim's tool-timeout variable, which
  // described a relationship that did not exist: the shim reads that variable and does
  // something with it, and the daemon reads this one and enforces the cap. Two numbers
  // that happen to both be 120 is not a match, and a comment claiming it is one invites
  // someone to change one and not the other. This is the number that does the work.
  "requestTimeoutSecs": 120,

  // Which model answers when the agent has not said. Off unless enabled, and ignored
  // entirely unless more than one backend is on -- a routing config with a single model
  // is not a degraded route, it is no route.
  //
  // When on, `default` takes the bare `onesystem` server name, so an unqualified
  // `onesystem.predict` reaches it. `tasks` is guidance the plugin logs, not dispatch:
  // routing a call by matching its text for a task name would be a classifier in front of
  // a classifier.
  "routing": {
    "enabled": false,
    "default": "laya",
    "tasks": {
      "engineering": "laya",
      "triage": "julia"
    }
  },

  "backends": {
    "laya": {
      "transport": "stdio-mcp",
      // The shim, not bare laya: it owns interpreter selection (the ROCm torch build
      // in the pipx venv, not the mise one that reports no CUDA device), the idle
      // unload watchdog, and the per-call timeout.
      //
      // LAYA_PYTHON must be set here. The shim reads it from its own environment, and
      // it is NOT inherited from the shell: `onesystem start` runs wherever you invoke
      // it, and LAYA_PYTHON only exists inside opencode.json's MCP environment block.
      // Omit it and the shim falls back to the mise interpreter, cannot import laya,
      // and dies on startup -- a failure that is easy to miss because the daemon keeps
      // answering with error payloads.
      //
      // It points into the runtime `onesystem install laya` created, not a pipx venv.
      // The installer owns the environment on purpose: a pipx venv is a shared,
      // mutable thing that anything on the machine can upgrade out from under the
      // model, and the ROCm torch build inside it is the part that must not move.
      "command": ["/path/to/bin/laya-mcp-idle-server"],

      // The tool names this backend exposes, without the `laya_` prefix. Required, and
      // the one place a model's surface is written down by hand.
      //
      // onesystem cannot discover these at startup. Reading them means forwarding
      // `tools/list` to the process, and that is the 20-54s load and 3 GB of VRAM that
      // lazy start exists to keep off session start -- so setup would cost a model load
      // per backend before the agent asked anything. Declared here, `/catalog` answers
      // without touching a process.
      //
      // If laya adds or renames a tool, add it here. A name here the process does not
      // answer fails the call with its own "unknown tool", which is loud at the moment of
      // the call rather than silent at session start.
      //
      // Measured against laya 0.3.21 on this machine, via its own `tools/list`:
      //
      //   onesystem status | onesystem route | onesystem predict | onesystem predict_batch
      //   onesystem route_batch | onesystem shortlist | onesystem preset | onesystem decide
      "tools": [
        "predict",
        "status",
        "route",
        "decide",
        "shortlist",
        "preset",
        "predict_batch",
        "route_batch"
      ],
      "env": {
        "LAYA_DEVICE": "cuda",
        "LAYA_PRELOAD": "0",
        "LAYA_IDLE_UNLOAD_SECS": "300",
        "LAYA_TOOL_TIMEOUT_SECS": "120",
        // `onesystem install laya` prints the exact path for your machine. The default
        // root is `~/.local/share/onesystem` (or `$ONESYSTEM_DATA_DIR`), so a hand-written
        // one looks like the line below. It is NOT `<repo>/runtimes/...`: the installer
        // never writes there, and a config pointing at it spawns a process that does not
        // exist -- which the daemon reports as a backend that failed to start.
        "LAYA_PYTHON": "/home/you/.local/share/onesystem/runtimes/laya/.venv/bin/python"
      },
      "startupTimeoutSecs": 180,

      // Registered as the `onesystem` MCP server, with `laya_` stripped from tool
      // names, so the surface reads `onesystem.predict` rather than
      // `onesystem.laya_predict`. The prefix is explicit because the daemon cannot know
      // a backend prefixes its tools with its own product name.
      "toolPrefix": "laya_"
    },

    // A second model, as a peer of laya rather than a replacement: same predict(state,
    // questions) contract, 0.66 GB of VRAM against laya's 3.01, and a 6s load against
    // 20-54s. It needs its own venv because it pins transformers<5.1.
    //
    // The command is its runtime's interpreter running the shim in this repo, rather than
    // a shim in a dotfile: onesystem owns the thing it spawns. `onesystem install julia`
    // prints the exact block for your machine.
    "julia": {
      "transport": "stdio-mcp",
      "command": [
        "/home/you/.local/share/onesystem/runtimes/julia/.venv/bin/python",
        "/path/to/onesystem/src/shims/julia-mcp.py"
      ],
      "env": {
        "JULIA_DEVICE": "cuda",
        // Weights, not code. Fetched once by the installer and kept outside the runtime,
        // because a reinstall replaces the runtime and would otherwise take them with it.
        "JULIA_CHECKPOINT": "/home/you/.local/share/onesystem/weights/julia"
      },
      "startupTimeoutSecs": 120,
      // No toolPrefix: the shim names its tool `predict`, which is what opencode should
      // see. A prefix is only for stripping a name a model puts on its own tools.
      "tools": ["predict"],
      "enabled": false
    },

    "rev": {
      "transport": "systemone-http",
      // Already-running service speaking POST /v1/systemone. onesystem does not
      // start it. Disabled until there is something listening.
      "baseUrl": "http://127.0.0.1:8000",
      "startupTimeoutSecs": 30,
      "enabled": false
    }
  }
}
