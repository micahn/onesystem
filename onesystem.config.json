{
  "host": "127.0.0.1",
  "port": 7331,

  // Wind down after this long with no traffic. Long on purpose: a model load costs
  // 20-54s and 3 GB of VRAM, so exiting sooner than this just moves the cost to the
  // next session. The daemon exits once nothing is warm, releasing the port and the GPU.
  "idleShutdownSecs": 600,

  // How often the idle check runs. A timestamp compare, so this can be cheap.
  "idleSweepSecs": 5,

  // Ceiling on one forwarded MCP call. Matches LAYA_TOOL_TIMEOUT_SECS in the shim.
  "requestTimeoutSecs": 120,

  // Which model answers when the agent has not said. Off unless enabled, and ignored
  // entirely unless more than one backend is on -- a routing config with a single model
  // is not a degraded route, it is no route.
  //
  // When on, `default` takes the bare `onesystem` server name, so an unqualified
  // `onesystem.predict` reaches it. `tasks` is guidance the plugin logs, not dispatch:
  // routing a call by matching its text for a task name would be a classifier in front of
  // a classifier.
  "routing": {
    "enabled": false,
    "default": "laya",
    "tasks": {
      "engineering": "laya",
      "triage": "julia"
    }
  },

  "backends": {
    "laya": {
      "transport": "stdio-mcp",
      // The shim, not bare laya: it owns interpreter selection (the ROCm torch build
      // in the pipx venv, not the mise one that reports no CUDA device), the idle
      // unload watchdog, and the per-call timeout.
      //
      // LAYA_PYTHON must be set here. The shim reads it from its own environment, and
      // it is NOT inherited from the shell: `onesystem start` runs wherever you invoke
      // it, and LAYA_PYTHON only exists inside opencode.json's MCP environment block.
      // Omit it and the shim falls back to the mise interpreter, cannot import laya,
      // and dies on startup -- a failure that is easy to miss because the daemon keeps
      // answering with error payloads.
      "command": ["/home/micah/.config/opencode/bin/laya-mcp-idle-server"],
      "env": {
        "LAYA_DEVICE": "cuda",
        "LAYA_PRELOAD": "0",
        "LAYA_IDLE_UNLOAD_SECS": "300",
        "LAYA_TOOL_TIMEOUT_SECS": "120",
        "LAYA_PYTHON": "/home/micah/.local/share/pipx/venvs/laya/bin/python"
      },
      "startupTimeoutSecs": 180,

      // Registered as the `onesystem` MCP server, with `laya_` stripped from tool
      // names, so the surface reads `onesystem.predict` rather than
      // `onesystem.laya_predict`. The prefix is explicit because the daemon cannot know
      // a backend prefixes its tools with its own product name.
      "toolPrefix": "laya_"
    },

    // A second model, as a peer of laya rather than a replacement: same predict(state,
    // questions) contract, 0.66 GB of VRAM against laya's 3.01, and a 6s load against
    // 20-54s. It needs its own venv because it pins transformers<5.1.
    //
    // The command is its runtime's interpreter running the shim in this repo, rather than
    // a shim in a dotfile: onesystem owns the thing it spawns. `onesystem install julia`
    // prints the exact block for your machine.
    "julia": {
      "transport": "stdio-mcp",
      "command": [
        "/home/micah/.local/share/onesystem/runtimes/julia/.venv/bin/python",
        "/home/micah/Projects/onesystem/src/shims/julia-mcp.py"
      ],
      "env": {
        "JULIA_DEVICE": "cuda",
        // Weights, not code. Fetched once by the installer and kept outside the runtime,
        // because a reinstall replaces the runtime and would otherwise take them with it.
        "JULIA_CHECKPOINT": "/home/micah/.local/share/onesystem/weights/julia",
        "JULIA_IDLE_UNLOAD_SECS": "300",
        "JULIA_TOOL_TIMEOUT_SECS": "120"
      },
      "startupTimeoutSecs": 120,
      // No toolPrefix: the shim names its tool `predict`, which is what opencode should
      // see. A prefix is only for stripping a name a model puts on its own tools.
      "enabled": false
    },

    "rev": {
      "transport": "systemone-http",
      // Already-running service speaking POST /v1/systemone. onesystem does not
      // start it. Disabled until there is something listening.
      "baseUrl": "http://127.0.0.1:8000",
      "startupTimeoutSecs": 30,
      "enabled": false
    }
  }
}
