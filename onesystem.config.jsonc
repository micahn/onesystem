// Template with placeholder paths. `onesystem install <model>` writes real paths
// and enables the model. Use `onesystem use <model>` to switch. See README.md.

{
  "host": "127.0.0.1",
  "port": 7331,

  // Stop idle local backends after this many seconds. Avoid frequent cold loads.
  "idleShutdownSecs": 600,

  // Seconds between idle checks. Must not exceed idleShutdownSecs.
  "idleSweepSecs": 5,

  // Maximum seconds per forwarded call, enforced by the daemon.
  "requestTimeoutSecs": 120,

  // Default model for multiple enabled backends. `tasks` is logged guidance only.
  "routing": {
    "enabled": false,
    "default": "laya",
    "tasks": {
      "engineering": "laya",
      "triage": "julia"
    }
  },

  "backends": {
    "laya": {
      "transport": "stdio-mcp",
      "command": ["/path/to/runtimes/laya/.venv/bin/laya-mcp-server"],
      "env": {
        "LAYA_DEVICE": "cuda",
        // Load weights on first use.
        "LAYA_PRELOAD": "0",
        // Set the interpreter here so all sessions use the same runtime.
        "LAYA_PYTHON": "/home/you/.local/share/onesystem/runtimes/laya/.venv/bin/python"
      },
      // Allow time to import transformers before the MCP handshake.
      "startupTimeoutSecs": 180,
      // Names without `laya_`. Declaring them avoids starting the model to list tools.
      "tools": [
        "predict",
        "status",
        "route",
        "decide",
        "shortlist",
        "preset",
        "predict_batch",
        "route_batch"
      ],
      "toolPrefix": "laya_"
    },

    "julia": {
      "transport": "stdio-mcp",
      "command": [
        "/home/you/.local/share/onesystem/runtimes/julia/.venv/bin/python",
        "/path/to/onesystem/src/shims/julia-mcp.py"
      ],
      "env": {
        "JULIA_DEVICE": "cuda",
        "JULIA_CHECKPOINT": "/home/you/.local/share/onesystem/weights/julia"
      },
      "startupTimeoutSecs": 120,
      "tools": ["predict"],
      "enabled": false
    }
  }
}
